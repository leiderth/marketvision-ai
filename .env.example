# ==== General ====
APP_ENV=development
LOG_LEVEL=info
DEFAULT_MODE=ANALYSIS_MODE   # ANALYSIS_MODE | PAPER_TRADING_MODE  (AUTONOMOUS_EXECUTION_MODE no soportado en este repo)

# ==== Base de datos ====
DATABASE_URL=sqlite:///./marketvision_dev.db
# Producción: postgresql+asyncpg://user:password@host:5432/marketvision
# TimescaleDB opcional: usar la misma URL de Postgres con la extensión habilitada

# ==== Market Data ====
MARKET_DATA_PROVIDER=twelve_data # twelve_data
MARKET_DATA_API_KEY=             # clave personal de Twelve Data (no compartir ni versionar)
MARKET_DATA_SYMBOL=              # p. ej. EUR/USD; elegir según permisos y necesidad
MARKET_DATA_INTERVAL=1min        # intervalo oficial de Twelve Data
MARKET_DATA_HISTORY_SIZE=500     # máximo histórico solicitado para arrancar indicadores
MARKET_DATA_WS_URL=              # opcional: URL oficial del WebSocket de Twelve Data
MARKET_DATA_MAX_PRICE_CHANGE_PCT=20
MARKET_REGIME_EXTREME_ATR_PCT=1.0
MARKET_REGIME_MAX_SPREAD_PCT=0.1

# ==== Calendario económico / noticias (opcional) ====
ECONOMIC_CALENDAR_API_KEY=                 # credencial de Trading Economics (solo backend)
ECONOMIC_CALENDAR_CURRENCIES=AUD,CAD,CHF,EUR,GBP,JPY,NZD,USD # divisas cubiertas explícitamente
ECONOMIC_CALENDAR_REFRESH_MINUTES=15       # intervalo de actualización; fallos fuerzan NO_TRADE
ECONOMIC_CALENDAR_EVENT_WINDOW_MINUTES=30  # ventana de bloqueo para eventos de alto impacto
ECONOMIC_CALENDAR_MAX_AGE_HOURS=6          # vigencia máxima de la última actualización

# ==== ML / Model Registry ====
MLFLOW_TRACKING_URI=./models/mlruns # reservado para integración futura con MLflow
ML_MODEL_REGISTRY_DIR=./models/registry
ML_ACTIVE_MODEL_VERSION=              # vacío = ningún ML activo; activar manualmente tras revisión
ML_MIN_CONFIDENCE=0.65                # puntuación de clase logística mínima (no calibrada)
ML_DRIFT_STATE_DIR=./data/model_drift # estado persistente del monitor, por versión de modelo
TRADE_DATABASE_PATH=./data/trade_learning.sqlite3
TRADE_DATASET_PATH=./data/paper_training.csv
VISION_CAPTURE_FPS=5                  # captura local continua; rango 1-15 FPS

# ==== Notificaciones ====
NOTIFICATIONS_ENABLED=true

# ==== Seguridad ====
SECRET_KEY=changeme-generate-a-real-secret
LOCAL_API_AUTH_TOKEN=changeme

# ==== Risk Manager (límites duros — ver backend/risk) ====
RISK_MAX_LOSS_PER_TRADE_PCT=1
RISK_MAX_DAILY_LOSS_PCT=5
RISK_MAX_DAILY_PROFIT_PCT=5
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_MAX_TRADES_PER_DAY=20
RISK_MAX_TRADES_PER_HOUR=5
RISK_PAPER_ACCOUNT_BALANCE=10000
RISK_STATE_PATH=./data/risk_state.json
