{
  "productName": "MarketVision AI",
  "version": "0.2.0",
  "identifier": "com.marketvisionai.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../frontend/dist",
    "beforeBuildCommand": "npm --prefix ../../frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "MarketVision AI",
        "width": 380,
        "height": 760,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "binaries/marketvision-backend/": "marketvision-backend/",
      "binaries/tesseract/": "tesseract/"
    }
  }
}
